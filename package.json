{
  "name": "api-rc",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"webpack --watch\"",
    "build": "bun run generate && bun run build:html && bun run build:browser && bun run build:server",
    "build:html": "bun run scripts/generate-html.ts ",
    "build:browser": "webpack",
    "copy": "bun run copy.ts",
    "generate": "bun run generate:server-registry && bun run generate:client-registry && bun run generate:version-json && bun run generate:restart-txt",
    "generate:client-registry": "bun run scripts/generate-client-registry.ts",
    "generate:server-registry": "bun run scripts/generate-server-registry.ts",
    "generate:version-json": "bun run scripts/generate-version-json.ts",
    "generate:restart-txt": "bun run scripts/generate-restart-txt.ts",
    "build:server": "bun run generate:server-registry && bun build src/server.ts --target=node --outfile=dist/server.js --packages=bundle",
    "dev:server": "bun run generate:server-registry && bun run --watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "lucide-react": "^1.16.0",
    "photoswipe": "^5.4.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.8.0",
    "swiper": "^12.1.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "fastify": "^5.8.5",
    "js-yaml": "^4.1.1",
    "mini-css-extract-plugin": "^2.9.4",
    "pino": "^10.3.1",
    "postcss": "^8.5.15",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "ts-loader": "^9.5.7",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-tsconfig-paths": "^6.1.1",
    "webpack": "^5.107.1",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.4"
  }
}
